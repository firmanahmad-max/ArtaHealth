# --- Server / Edge Functions SAJA (JANGAN pernah ke client) ---
SUPABASE_SERVICE_ROLE_KEY=
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:halo@artahealth.id
